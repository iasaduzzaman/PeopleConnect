@model PeopleConnect.Domain.Entities.Post

<div class="card-border-0 shadow-sm rounded-4 card border-success bg-success bg-opacity-10">
    <div class="card-body p-3 p-md-4">
        <h1 class="fw-bold fs-2 mb-1 text-danger text-center">Delete a Post</h1>
        <p class="text-center">Share what you have or what you need</p>

        <form method="post" class="row">
            <input asp-for="PostId" hidden />
            <div class="rounded-3 text-center p-3 h-100">
                <label asp-for="PostType" class="ms-2">Post Type</label>
                <select asp-for="PostType" disabled class="form-control border shadow-sm text-center">
                    <option value=""> --Select Option-- </option>
                    <option>I Want to Give</option>
                    <option>I Need Help</option>
                </select>
                <span asp-validation-for="PostType" class="text-danger"></span>
            </div>

            <div class="text-black align-content-center p-3 h-100">
                <label asp-for="PostTitle" class="ms-2">PostTitle</label>
                <input asp-for="PostTitle" disabled type="text" class="form-control border shadow-sm" />
            </div>
            <div class="text-black align-content-center p-3 h-100">
                <label asp-for="Description" class="ms-2">Description</label>
                <input asp-for="Description" disabled type="text" class="form-control border shadow-sm" />
            </div>

            <div class="text-black align-content-center p-3 h-100">
                <label asp-for="Name" class="ms-2">Name</label>
                <input asp-for="Name" disabled type="text" class="form-control border shadow-sm" />
            </div>

            <div class="text-black align-content-center p-3 h-100">
                <label asp-for="Contact" class="ms-2">Contact</label>
                <input asp-for="Contact" disabled type="number" class="form-control border shadow-sm" />
            </div>

            <div class="text-black align-content-center p-3 h-100">
                <label asp-for="Address" class="ms-2">Address</label>
                <input asp-for="Address" disabled type="Text" class="form-control border shadow-sm" />
            </div>

            <div class="text-black align-content-center p-3 h-100">
                <label asp-for="ImageUrl" class="ms-2">ImageUrl</label>
                <input asp-for="ImageUrl" disabled type="Text" class="form-control border shadow-sm" />
            </div>

            <div class="row pt-3">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-trash-fill"></i> Delete
                    </button>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Post" asp-action="Index" class="btn btn-secondary w-100">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </div>

        </form>
    </div>
</div>

